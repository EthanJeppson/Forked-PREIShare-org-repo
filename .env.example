# .env.example: commit this file. Never put real keys here.
#
# Copy to .env.local (or .env) at the repo root and fill in the values from
# Supabase -> Project Settings -> API. The copy is gitignored; this file is not.
# Restart `npm run dev` after creating or editing the local copy.
#
# See docs/setup/supabase-env-checklist.md for the full setup checklist and
# docs/requirements/sponsor-auth-and-listings-brief.md for the server-only boundary.

# ---------------------------------------------------------------------------
# PUBLIC / BROWSER-SAFE
# Vite only exposes variables that start with VITE_ to client code (read with
# import.meta.env.VITE_*). These two values are not secrets, but they are also
# not a bypass: Row Level Security is what protects the data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The dashboard may label this key "anon" or "publishable". Use that one.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# SERVER-ONLY
# No VITE_ prefix. Read with process.env inside server code only (for example
# a createServerFn handler), never at module scope of a file the browser imports.
# ---------------------------------------------------------------------------
# Same project URL for server code that does not read VITE_ variables.
SUPABASE_URL=https://your-project-ref.supabase.co

# SECRET. Bypasses Row Level Security. Never prefix with VITE_, never import it
# in browser code, never commit a real value, never paste it into chat or docs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
